# Nested git repos (cloned skillpacks — huge, tracked upstream; do NOT embed here)
skillpacks/

# Runtime / local state
.mycelium/
.claude/last-session.md

# Python bytecode
__pycache__/
*.pyc

# pixi environment (regenerable via `pixi install`; pixi.lock IS tracked)
.pixi/

# GNPS2 bundle is immutable + canonical upstream lives in sibling ../MSV000090464 (+ ../Js_Bd
# expanded tree) and MassIVE MSV000090464. Do not embed the 234M bundle here; data/raw is
# regenerable/restorable from those sources. Curated metadata (small) is tracked.
data/raw/
.worktrees/

# genome-bioactivity-linkage: downloaded/generated reference annotations and
# other pipeline outputs are regenerable via scripts/*.sh; do not commit.
analysis/genome_bioactivity_linkage/results/
analysis/sirius*/logs/*.log

# rnaseq-expression: STAR genome indices (SA/SAindex/Genome routinely
# hundreds of MB, over GitHub's 100 MB per-file limit) and BAMs are
# regenerable via scripts/*.sh from data/raw/ (also ignored) + the
# reference genomes; do not commit.
analysis/rnaseq_expression/results/

shard_*/
*.sirius
*.mgf

# SLURM job stdout/stderr (regenerable, noisy in git status)
logs/
